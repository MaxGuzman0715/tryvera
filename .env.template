# LLM: choose provider + model in the app Config (stored in data/app_settings.json).
# Set the API key for the provider you use:
OPENROUTER_API_KEY=
OPENAI_API_KEY=sk-your-key-here
# DeepSeek (OpenAI-compatible): https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Optional override (default https://api.deepseek.com/v1)
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Model: OpenRouter default is Qwen 3.6 Plus (free). Override with OPENROUTER_MODEL, or set OPENAI_MODEL as fallback.
OPENROUTER_MODEL=qwen/qwen3.6-plus:free
OPENAI_MODEL=gpt-4o-mini

# Optional OpenRouter (OpenAI-compatible API):
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://yoursite.example
# OPENROUTER_APP_TITLE=Enpply

PORT=80
CLIENT_PORT=5273
DATA_DIR=./data
OUTPUT_ROOT=./output

# Verbose tracing: set to 1 to write full inputs/outputs per generation step to data/logs/verbose/<appId>.log
# ENPPLY_VERBOSE=1

# Client feature flag: show/hide Analytics tab and route in the UI.
# (Vite client env vars must start with VITE_)
# VITE_ENABLE_ANALYTICS_TAB=1

# PDF: default is Chromium + HTML templates (résumé/CV themes from server/templates apply).
# Use plain PDFKit only (faster, no theme styling):
# ENPPLY_PDF_ENGINE=pdfkit
# Aliases for Chromium: chromium, html, puppeteer (same as unset). Optional: PUPPETEER_EXECUTABLE_PATH.
# Gray “Template · Section: …” lines under headings (default: off). Set to 1 only for layout debugging:
# ENPPLY_RESUME_TEMPLATE_HINTS=1
