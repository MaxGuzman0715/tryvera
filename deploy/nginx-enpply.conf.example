# Example: TLS reverse proxy in front of Enpply (Docker publishes 3001 on localhost).
# Copy to e.g. /etc/nginx/sites-available/enpply, adjust server_name and cert paths,
# then `sudo nginx -t && sudo systemctl reload nginx`.
#
# upstream enpply { ... } not required if proxy_pass is fixed.

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name enpply.example.com;

    ssl_certificate     /etc/letsencrypt/live/enpply.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/enpply.example.com/privkey.pem;

    client_max_body_size 5m;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name enpply.example.com;
    return 301 https://$host$request_uri;
}
